APP_NAME=Kreva
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database lokal XAMPP
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=kreva
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file

# Object storage (S3 / Cloudflare R2)
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-3
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pembayaran: fake (lokal) | midtrans
PAYMENT_DRIVER=fake
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Aturan bisnis (bisa diubah admin lewat tabel settings)
KREVA_COMMISSION_PERCENT=5
KREVA_PAYMENT_EXPIRE_HOURS=24
KREVA_AUTO_COMPLETE_DAYS=3
KREVA_MIN_PAYOUT=50000
KREVA_PAYOUT_WAIT_DAYS=3

# Asisten AI produk (informasi produk dan pertanyaan dikirim ke OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

MAIL_MAILER=log
